{
    "name":  "dsh-account-avatar",
    "version":  "0.2.0",
    "type":  "module",
    "description":  "Replaces the sidebar account avatar with your own picture and name: upload, crop, keep a history of up to 100, pick a shape. Stored on this machine; the account menu, sign-in and notifications stay untouched.",
    "license":  "MIT",
    "author":  "LunateTy",
    "keywords":  [
                     "dsh",
                     "dsh-plugin",
                     "deepseek-harness",
                     "avatar",
                     "profile-picture",
                     "sidebar",
                     "customization"
                 ],
    "homepage":  "https://github.com/LunateTy/dsh-account-avatar#readme",
    "repository":  {
                       "type":  "git",
                       "url":  "git+https://github.com/LunateTy/dsh-account-avatar.git"
                   },
    "bugs":  {
                 "url":  "https://github.com/LunateTy/dsh-account-avatar/issues"
             },
    "exports":  {
                    ".":  "./index.js",
                    "./client":  "./client.js",
                    "./locale/*.json":  "./locale/*.json",
                    "./icon":  "./icon.svg"
                },
    "files":  [
                  "index.js",
                  "client.js",
                  "src",
                  "build.mjs",
                  "cordis.patch.yml",
                  "locale/*.json",
                  "docs",
                  "assets/panel-*.png",
                  "icon.svg"
              ],
    "scripts":  {
                    "build":  "node build.mjs",
                    "check":  "node build.mjs --check"
                },
    "dsh":  {
                "bundle":  {
                               "patch":  "./cordis.patch.yml"
                           },
                "client":  {
                               "platform":  "web",
                               "immediately":  true
                           }
            }
}